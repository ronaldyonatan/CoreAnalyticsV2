# OPTIONAL trusted operator shell configuration, stored OUTSIDE your repository.
# Install to ~/.config/coreanalyticsv2/stored-worker.env and chmod 600.
# This file is sourced by the worker startup script; NEVER use uploaded/untrusted input.
# Do not paste credentials into chat or commit this file to Git.

# Worker control plane. Keep your already working DSN from your secure config.
# export STUDIO_INGEST_SQL_CONNECTION_STRING='DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;...'

# The host policy is dynamic. DO NOT set static allowed IP networks for this rollout.
export STUDIO_SQL_HOST_POLICY=dynamic
# Enable ONLY for trusted internal/private networks, not a public shared worker.
# export STUDIO_SQL_ALLOW_PRIVATE=true

# SQL Server and PostgreSQL use distinct port policies in this patch.
export STUDIO_SQL_ALLOWED_PORTS=1433
export STUDIO_POSTGRESQL_ALLOWED_PORTS=5432

# Certificate trust for SQL Server is opt-in, if your existing source requires it.
# export STUDIO_ALLOW_UNTRUSTED_CERT=true

# Optional worker-specific overrides, otherwise paths and driver JARs are auto detected:
# export STUDIO_BATCH_STORAGE_ROOT="$HOME/CoreAnalyticsData/parquet"
# export STUDIO_BATCH_LOCAL_PYTHON="$HOME/CoreAnalyticsV2/data-studio-worker/.venv/bin/python"
# export STUDIO_BATCH_LOCAL_SCRIPT="$HOME/CoreAnalyticsV2/data-studio-worker/run_batch.py"
# export STUDIO_SPARK_MASTER='local[2]'

# DEV SQL script datasets, scoped to the existing bi Connection. SQL runs with
# the stored Connection account, including any write privileges it has.
# export STUDIO_SQL_SCRIPT_DATASET_DEV_ENABLED=true
# export STUDIO_SQL_SCRIPT_PREVIEW_DEV_CONNECTION_ID='4a8e1bd8-41fb-47ff-b1e9-310ca46a83b3'
# export STUDIO_SQL_SCRIPT_QUERY_TIMEOUT=300
# export STUDIO_SQL_SCRIPT_MAX_ROWS=10000000
