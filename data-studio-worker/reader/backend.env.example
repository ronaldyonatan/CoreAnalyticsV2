# Add to the backend runtime environment. Do not commit real secrets.
# Loopback URL is for API and cluster on the same development host.
# For separate servers, use a private HTTPS proxy/tunnel to the cluster reader.
STUDIO_PARQUET_READER_URL=http://127.0.0.1:18089
STUDIO_PARQUET_READER_TOKEN_FILE=/secure/coreanalytics/parquet-reader-token
# Optional: CA bundle for your private HTTPS endpoint; certificate verification stays enabled.
# STUDIO_PARQUET_READER_CA_FILE=/secure/coreanalytics/cluster-ca.pem
# Explicit opt-in only for an operator-controlled private HTTP container network.
# STUDIO_PARQUET_ALLOW_HTTP=true
