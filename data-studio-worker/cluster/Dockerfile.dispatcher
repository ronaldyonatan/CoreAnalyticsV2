ARG SPARK_IMAGE=coreanalytics-studio-spark:3.5.8
FROM ${SPARK_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libodbc2 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir requests==2.32.5 Flask==3.1.2 python-dotenv==1.2.1 cryptography==46.0.3 pyodbc==5.3.0 argon2-cffi==25.1.0 certifi==2025.11.12
COPY --chown=185:185 voice-auth-backend/app /opt/control/app
COPY --chown=185:185 data-studio-worker/cluster/start.py /opt/coreanalytics/start_cluster.py
WORKDIR /opt/control
ENV PYTHONPATH=/opt/control
CMD ["dispatcher"]
