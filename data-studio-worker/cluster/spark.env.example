# Copy to an operator-controlled env file; use --env-file when invoking Compose.
# Data path is on the Docker HOST, outside the container. Create it explicitly first.
STUDIO_PARQUET_HOST_PATH=/srv/coreanalytics/parquet
STUDIO_SPARK_SECRET_FILE=/secure/coreanalytics/spark-auth-secret
STUDIO_PARQUET_READER_SECRET_FILE=/secure/coreanalytics/parquet-reader-token
STUDIO_DISPATCHER_ENV_FILE=/secure/coreanalytics/dispatcher.env
