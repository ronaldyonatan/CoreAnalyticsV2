# Copy outside the repository and restrict file permissions. Never commit real values.
CORE_API_URL=https://beam.example.invalid/api
CORE_API_TIMEOUT=30
BEAM_X_CONNECTION=REPLACE_WITH_PRIVATE_SERVICE_CONNECTION
BEAM_X_TOKEN=REPLACE_WITH_PRIVATE_SERVICE_TOKEN
# Same key used by CoreAnalytics to decrypt approved connection records.
STUDIO_FERNET_KEY=REPLACE_WITH_EXISTING_APPLICATION_KEY
STUDIO_SQL_HOST_POLICY=allowlist
STUDIO_ALLOWED_SQL_HOSTS=sql-source.example.internal
STUDIO_SQL_ALLOWED_PORTS=1433
# If your deployment requires CIDR restrictions, set approved networks here.
# STUDIO_SQL_ALLOWED_NETWORKS=10.20.0.0/16
STUDIO_BATCH_JOB_TIMEOUT=3600
